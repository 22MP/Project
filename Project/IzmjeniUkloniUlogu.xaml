<Window x:Class="Project.IzmjeniUkloniUlogu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="IzmjeniUkloniUlogu" Height="700" Width="750">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Slike/Background.jpg"  Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="White" CornerRadius="10, 10, 10, 10" Margin="50,40,50,35">
            <StackPanel Margin="10 5">
                <Label HorizontalAlignment="Center" FontWeight="Bold" FontSize="25" Content="Izmjeni ulogu" Margin="0 5 0 0"/>

                <Label Content="Šifra:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="sifra" FontSize="16"/>

                <Label Content="Naziv:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="naziv" FontSize="16"/>

                <Label Content="Predstava:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="predstava" FontSize="16"/>

                <Label Content="Tip uloge:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="tipUloge" FontSize="16"/>

                <Label Content="Dostupnost:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="dostupnost" FontSize="16"/>

                <Button Name="ikonica" Click="ikonica_Click" Background="White" Height="116" Width="148"  Margin="0 30 0 0">
                    <Image x:Name="slika" Source="/Slike/Placeholder.jpg" Stretch="Uniform" Height="116" Width="148" HorizontalAlignment="Center"/>
                </Button>

                <Button Content="Izmjeni" Name="izmjeniBtn" Click="izmjeniBtn_Click" Background="White" FontWeight="Bold" FontSize="25" Margin="150 20 150 1 " Height="40"/>
                <Button Content="Ukloni" Name="ukloniBtn" Click="ukloniBtn_Click" Background="White" FontWeight="Bold" FontSize="25" Margin="150 5" Height="40"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
