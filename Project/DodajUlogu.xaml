<Window x:Class="Project.DodajUlogu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="DodajUlogu" Height="700" Width="750">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Slike/Background.jpg"  Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Background="White" CornerRadius="10, 10, 10, 10" Margin="50 70">
            <StackPanel Margin="10 5">
                <Label HorizontalAlignment="Center" FontWeight="Bold" FontSize="25" Content="Dodaj ulogu" Margin="0 5 0 0"/>

                <Label Content="Šifra:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="sifra" FontSize="16" FontWeight="Bold"/>

                <Label Content="Naziv:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="naziv" FontSize="16" FontWeight="Bold"/>

                <Label Content="Predstava:" FontSize="16" FontWeight="Bold"/>
                <TextBox Name="predstava" FontSize="16" FontWeight="Bold"/>

                <Label Content="Tip uloge:" FontSize="16" FontWeight="Bold"/>
                <ComboBox Width="250" Name="tipUloge" HorizontalAlignment="Left"   >
                    <ComboBoxItem>Glavna</ComboBoxItem>
                    <ComboBoxItem>Sporedna</ComboBoxItem>
                </ComboBox>

                <Button Name="ikonica" Click="ikonica_Click" Background="White" Height="116" Width="148"  Margin="0 30 0 0">
                    <Image x:Name="slika"  Source="Slike/Placeholder.jpg" Stretch="Uniform" Height="116" Width="148" HorizontalAlignment="Center"/>
                </Button>
                <Button Content="Dodaj" Name="dodajBtn" Click="dodajBtn_Click" Background="White" FontWeight="Bold" FontSize="30" Margin="150 40 " Height="45"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
