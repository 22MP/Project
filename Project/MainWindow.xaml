<Window x:Class="Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">
    <Window.Resources>
        <Style TargetType="DataGridCell">
            <Style.Setters>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center" />
                <Setter Property="TextElement.FontSize" Value="20" />
            </Style.Setters>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl>
            <!-- Prvi tab -->
            <TabItem Header="Uloge">
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="Slike/Background.jpg"  Stretch="UniformToFill"/>
                    </Grid.Background>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"></RowDefinition>
                        <RowDefinition Height="4*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="40" Foreground="White" FontWeight="Bold" Margin="20 0" >Uloge u pozorištu</TextBlock>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical">
                        <Label Content="Pretraži uloge: " FontSize="16" FontWeight="Bold"  Foreground="White"/>
                        <TextBox Name="tab1Pretraga" FontSize="30" TextChanged="tab1Pretraga_TextChanged"  TextWrapping="Wrap" Margin="5 0"  />
                    </StackPanel>

                    <DataGrid  Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="30 0" FontSize="14" FontWeight="Medium" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="tab1Uloge" ItemsSource="{Binding Uloga}" IsReadOnly="True" AutoGenerateColumns="False" MouseDoubleClick="tab1Uloge_MouseDoubleClick" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn  Width="0.5*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source = "{Binding Path=Ikonica}" Width="90" Height="80" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Šifra" Width="*" Binding="{Binding Path=Sifra}"/>
                            <DataGridTextColumn Header="Naziv" Width="*" Binding="{Binding Path=Naziv}"/>
                            <DataGridTextColumn Header="Predstava" Width="*" Binding="{Binding Path=Predstava}"/>
                            <DataGridTextColumn Header="Tip uloge" Width="*" Binding="{Binding Path=TipUloge}"/>
                            <DataGridTextColumn Header="Dostupnost" Width="*" Binding="{Binding Path=Dostupnost}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Name="tab1Dodaj" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center"  HorizontalAlignment="Center" FontSize="25" Padding="5" Background="White" Click="tab1Dodaj_Click">Dodaj ulogu</Button>
                </Grid>
            </TabItem>

            <!-- Drugi tab -->
            <TabItem Header="Dodeli ulogu">
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="Slike/Background.jpg"  Stretch="UniformToFill"/>
                    </Grid.Background>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TreeView Name="Tab2_ListaUloga" FontSize="15" Grid.Column="0" Margin="100 100 0 50" PreviewMouseLeftButtonDown="Tab2_ListaUloga_PreviewMouseLeftButtonDown"
                              MouseMove="Tab2_ListaUloga_MouseMove">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:Predstava}" ItemsSource="{Binding SveUloge}">
                                <TextBlock Text="{Binding Naziv}"/>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type local:Uloga}">
                                
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding Ikonica}" Width="30" Height="30"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock>(</TextBlock>
                                        <TextBlock Text="{Binding Sifra}">
                                        </TextBlock>
                                        <TextBlock>)</TextBlock>
                                        <TextBlock Text="{Binding Naziv}" FontWeight="Bold"/>
                                        <TextBlock>[</TextBlock>
                                        <TextBlock Text="{Binding TipUloge}"/>
                                        <TextBlock>]</TextBlock>                                                                               
                                    </TextBlock>
                                </StackPanel>
                                
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <TreeView Name="Tab2_ListaGlumaca" FontSize="15" Grid.Column="1" Margin="0 100 100 50" AllowDrop="True"
                              DragEnter="Tab2_ListaGlumaca_DragEnter" Drop="Tab2_ListaGlumaca_Drop">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:Glumac}" ItemsSource="{Binding DodeljeneUloge}">
                                <TextBlock>
                                    <TextBlock Text="{Binding Ime}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Prezime}" FontWeight="Bold"/>
                                    <TextBlock>[</TextBlock>
                                    <TextBlock Text="{Binding JMBG}"/>
                                    <TextBlock>]</TextBlock>
                                </TextBlock>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type local:Uloga}">
                                <TextBlock>
                                    <TextBlock Text="{Binding Naziv}"/>
                                    <TextBlock>[</TextBlock>
                                    <TextBlock Text="{Binding Predstava}" FontStyle="Italic"/>
                                    <TextBlock>]</TextBlock>
                                </TextBlock>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0 0 0 50" Padding="5" Background="White" Click="Tab2_Dodaj_Click">Dodaj glumca</Button>
    

                </Grid>
            </TabItem>

            <!-- Treći tab -->
            <TabItem Header="Istorija" VerticalAlignment="Top">
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="Slike/Background.jpg"  Stretch="UniformToFill"/>
                    </Grid.Background>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.4*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="40" Foreground="White" FontWeight="Bold" Margin="20,0,20,0" >Istorija dodjeljenih uloga</TextBlock>
                    <Button Name="tab3Export" Grid.Column="1" Grid.Row="0"  VerticalAlignment="Center"  HorizontalAlignment="Center" FontSize="25" Padding="5" Width="200" Background="White" Click="tab3Export_Click" >Export</Button>

                    <DataGrid  Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="20 5 20 25" FontSize="14" FontWeight="Medium" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="tab3Uloge" ItemsSource="{Binding Uloga}" IsReadOnly="True" AutoGenerateColumns="False" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn  Header="ULOGE" Width="0.5*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source = "{Binding Path=Ikonica}" Width="90" Height="80" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Šifra" Width="*" Binding="{Binding Path=Sifra}"/>
                            <DataGridTextColumn Header="Naziv" Width="*" Binding="{Binding Path=Naziv}"/>
                            <DataGridTextColumn Header="Predstava" Width="*" Binding="{Binding Path=Predstava}"/>
                            <DataGridTextColumn Header="Tip uloge" Width="*" Binding="{Binding Path=TipUloge}"/>
                            <DataGridTextColumn Header="Dostupnost" Width="*" Binding="{Binding Path=Dostupnost}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid  Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="20 5 20 25" FontSize="14" FontWeight="Medium" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="tab3Glumci" ItemsSource="{Binding Glumac}" IsReadOnly="True" AutoGenerateColumns="False" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="GLUMCI" Width="0.5*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source = "{Binding Path=Ikonica}" Width="90" Height="80" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ime" Width="*" Binding="{Binding Path=Ime}"/>
                            <DataGridTextColumn Header="Prezime" Width="*" Binding="{Binding Path=Prezime}"/>
                            <DataGridTextColumn Header="Predstava" Width="*" Binding="{Binding Path=Predstava}"/>
                            <DataGridTextColumn Header="Broj dodjeljenih uloga" Width="*" Binding="{Binding Path= Ime}"/>
                            <DataGridTextColumn Header="Omiljena uloga" Width="*" Binding="{Binding Path=Prezime}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>

</Window>

